{
  "name": "fabrica-de-futbol",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretest": "node scripts/check-runtime.mjs && node scripts/check-private-sql.mjs",
    "test": "vitest run --project unit --project integration --project ui",
    "pretest:fast": "node scripts/check-runtime.mjs",
    "test:fast": "node scripts/run-fast-tests.mjs",
    "pretest:mutations": "node scripts/check-runtime.mjs",
    "test:mutations": "node scripts/check-test-mutations.mjs",
    "pretest:postgres": "node scripts/check-runtime.mjs && node scripts/check-private-sql.mjs",
    "test:postgres": "node scripts/check-postgres-concurrency.mjs",
    "pretest:watch": "node scripts/check-runtime.mjs && node scripts/check-private-sql.mjs",
    "test:watch": "vitest --project unit --project integration --project ui",
    "pretest:coverage": "node scripts/check-runtime.mjs && node scripts/check-private-sql.mjs",
    "test:coverage": "node scripts/run-coverage-tests.mjs",
    "pretest:e2e:preflight": "node scripts/check-runtime.mjs",
    "test:e2e:preflight": "node scripts/check-e2e-env.mjs",
    "test:e2e:sql": "node scripts/check-e2e-sql.mjs",
    "pretest:e2e": "node scripts/check-runtime.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "agent:impact": "node scripts/check-agent-impact.mjs",
    "guardrails": "node scripts/check-git-guardrails.mjs",
    "preverify": "node scripts/check-runtime.mjs",
    "verify": "npm run sql:verify && npm run guardrails && npm run lint && npm run typecheck && npm run test:coverage && npm run test:postgres && npm run test:mutations && npm run build",
    "verify:smoke": "npm run verify && npm run test:e2e",
    "prepare": "husky",
    "clean": "rimraf .next",
    "sql:build-schema": "node scripts/build-schema-sql.mjs",
    "sql:verify": "node scripts/check-private-sql.mjs",
    "sql:package": "node scripts/package-sql-artifact.mjs",
    "sql:publish-artifact": "node scripts/publish-sql-artifact.mjs",
    "sql:package-upgrades": "node scripts/package-sql-upgrade-artifact.mjs",
    "sql:publish-upgrades": "node scripts/publish-sql-upgrade-artifact.mjs",
    "storage:copy": "node scripts/copy-storage-bucket.mjs",
    "ops:groups": "node scripts/report-groups-operations.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.66.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "next": "^16.3.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
